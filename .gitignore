node_modules/
.next/
test-results/
playwright-report/
.env
.env.local

# JUL-98 step 8: each seat's brief, progress, answer and run record, written in the
# card's working copy. Ignored so the working copy still removes cleanly (Orca
# refuses to remove one holding an untracked file, measured 23 Sep).
.julia/

# Playwright CLI output (may contain credentials)
.playwright-cli/
# Local run artifacts: proof kept by verify-julia, and the checkouts and records
# the shipping machine writes beside it
.artifacts/

# Command Code local session state
.commandcode/

# Mastra Studio's build output and its default store, both regenerated by
# `npx mastra dev`
.mastra/
mastra.duckdb

# Firebase emulator run logs
firestore-debug.log
firebase-debug.log
ui-debug.log

# TLA+ model checker downloaded by scripts/check-recipes-model.mjs
formal/.tools/

# Graphify output: commit the two graphs, not the caches, reports or the
# per-package intermediate graphs.
graphify-out/*
!graphify-out/graph.json
!graphify-out/mastra/
graphify-out/mastra/*
!graphify-out/mastra/graph.json
!graphify-out/mastra/versions.json

# proof project credentials and the vault template written while provisioning
.firebase-proof.json
.firebase-proof-keys/
.firebase-vault-*.json
.proof/
