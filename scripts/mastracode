#!/bin/sh
# Runs Mastra Code with its own trace file, then hands over to the real program.
#
# Mastra Code opens its trace store once, at startup, and DuckDB admits one writer per file,
# so a session that starts while another holds observability.duckdb records no traces at all
# and its cost never reaches a scorecard (`@mastra/code-sdk/dist/index.js:323`). Every launch
# therefore gets a file of its own under the traces directory, and the files of sessions that
# have finished are folded into archive.duckdb and deleted, which is what returns the disk.
#
# Installed as ~/.local/bin/mastracode by scripts/install-launcher.mjs, which points that
# path at this file, so an edit here takes effect at the next launch.
set -u

self=$(readlink -f "$0")
repo=$(dirname "$(dirname "$self")")
real="${MASTRACODE_REAL_BIN:-$HOME/.local/lib/mastracode-program/node_modules/.bin/mastracode}"
if [ ! -x "$real" ]; then
  echo "mastracode launcher: no Mastra Code program at $real" >&2
  exit 1
fi

traces="${JULIA_TRACES_DIR:-${MASTRA_APP_DATA_DIR:-$HOME/.local/share/mastracode}/traces}"
mkdir -p "$traces" || exit 1
JULIA_TRACES_DIR="$traces"
export JULIA_TRACES_DIR
if [ -z "${MASTRA_OBSERVABILITY_DB_PATH:-}" ]; then
  MASTRA_OBSERVABILITY_DB_PATH="$traces/$(date -u +%Y%m%dT%H%M%SZ)-$$.duckdb"
  export MASTRA_OBSERVABILITY_DB_PATH
fi

# Bounded so a slow disk cannot hold up the session, and never fatal: a fold that fails is
# retried at the next launch, and a file a session still holds is left alone by the fold.
if [ -f "$repo/scripts/trace-store.mjs" ]; then
  timeout 60 node "$repo/scripts/trace-store.mjs" fold --quiet || true
else
  echo "mastracode launcher: no trace-store.mjs beside this file, so finished trace files are not folded" >&2
fi

exec "$real" "$@"
