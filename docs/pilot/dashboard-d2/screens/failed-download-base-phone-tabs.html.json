{
  "dataString": "\u003c!DOCTYPE html\u003e\n\n\u003chtml lang=\"en\"\u003e\u003chead\u003e\n\u003cmeta charset=\"utf-8\"/\u003e\n\u003cmeta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/\u003e\n\u003ctitle\u003eTodd's Factory · Operations Control\u003c/title\u003e\n\u003c!-- Material Symbols Outlined --\u003e\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/\u003e\n\u003c!-- Google Fonts: Plus Jakarta Sans --\u003e\n\u003clink href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/\u003e\n\u003clink crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/\u003e\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\"/\u003e\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/\u003e\n\u003c!-- Tailwind CSS --\u003e\n\u003cscript src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"\u003e\u003c/script\u003e\n\u003cscript id=\"tailwind-config\"\u003e\n    tailwind.config = {\n      darkMode: \"class\",\n      theme: {\n        extend: {\n          \"colors\": {\n            \"surface-tint\": \"#4d44e3\",\n            \"surface-container\": \"#e5eeff\",\n            \"surface-container-low\": \"#eff4ff\",\n            \"on-tertiary\": \"#ffffff\",\n            \"surface-bright\": \"#f8f9ff\",\n            \"surface-container-lowest\": \"#ffffff\",\n            \"primary-container\": \"#4f46e5\",\n            \"surface\": \"#f8f9ff\",\n            \"primary-fixed-dim\": \"#c3c0ff\",\n            \"on-primary-fixed\": \"#0f0069\",\n            \"on-error\": \"#ffffff\",\n            \"inverse-primary\": \"#c3c0ff\",\n            \"background\": \"#f8f9ff\",\n            \"surface-container-high\": \"#dce9ff\",\n            \"secondary\": \"#00687a\",\n            \"on-secondary-fixed-variant\": \"#004e5c\",\n            \"surface-dim\": \"#cbdbf5\",\n            \"inverse-on-surface\": \"#eaf1ff\",\n            \"error-container\": \"#ffdad6\",\n            \"inverse-surface\": \"#213145\",\n            \"on-surface-variant\": \"#464555\",\n            \"on-secondary-fixed\": \"#001f26\",\n            \"on-tertiary-fixed\": \"#2a1700\",\n            \"tertiary-fixed-dim\": \"#ffb95f\",\n            \"on-primary-fixed-variant\": \"#3323cc\",\n            \"on-secondary\": \"#ffffff\",\n            \"on-tertiary-container\": \"#ffd4a4\",\n            \"secondary-container\": \"#57dffe\",\n            \"on-error-container\": \"#93000a\",\n            \"on-primary-container\": \"#dad7ff\",\n            \"on-secondary-container\": \"#006172\",\n            \"secondary-fixed-dim\": \"#4cd7f6\",\n            \"on-primary\": \"#ffffff\",\n            \"tertiary-container\": \"#885500\",\n            \"tertiary-fixed\": \"#ffddb8\",\n            \"primary-fixed\": \"#e2dfff\",\n            \"outline-variant\": \"#c7c4d8\",\n            \"outline\": \"#777587\",\n            \"surface-variant\": \"#d3e4fe\",\n            \"on-surface\": \"#0b1c30\",\n            \"on-tertiary-fixed-variant\": \"#653e00\",\n            \"on-background\": \"#0b1c30\",\n            \"tertiary\": \"#684000\",\n            \"error\": \"#ba1a1a\",\n            \"surface-container-highest\": \"#d3e4fe\",\n            \"primary\": \"#3525cd\",\n            \"secondary-fixed\": \"#acedff\"\n          },\n          \"borderRadius\": {\n            \"DEFAULT\": \"0.25rem\",\n            \"lg\": \"0.5rem\",\n            \"xl\": \"0.75rem\",\n            \"full\": \"9999px\"\n          },\n          \"spacing\": {\n            \"space-md\": \"0.75rem\",\n            \"margin\": \"1rem\",\n            \"space-sm\": \"0.5rem\",\n            \"space-xs\": \"0.25rem\",\n            \"gutter\": \"0.75rem\",\n            \"space-xl\": \"1.5rem\",\n            \"space-lg\": \"1rem\"\n          },\n          \"fontFamily\": {\n            \"label-sm\": [\"Plus Jakarta Sans\"],\n            \"body-sm\": [\"Plus Jakarta Sans\"],\n            \"headline-xl\": [\"Plus Jakarta Sans\"],\n            \"headline-md\": [\"Plus Jakarta Sans\"],\n            \"body-md\": [\"Plus Jakarta Sans\"],\n            \"headline-lg\": [\"Plus Jakarta Sans\"],\n            \"label-md\": [\"Plus Jakarta Sans\"],\n            \"label-lg\": [\"Plus Jakarta Sans\"],\n            \"headline-sm\": [\"Plus Jakarta Sans\"],\n            \"body-lg\": [\"Plus Jakarta Sans\"]\n          },\n          \"fontSize\": {\n            \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"fontWeight\": \"700\" }],\n            \"body-sm\": [\"13px\", { \"lineHeight\": \"18px\", \"fontWeight\": \"400\" }],\n            \"headline-xl\": [\"28px\", { \"lineHeight\": \"34px\", \"fontWeight\": \"800\" }],\n            \"headline-md\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"700\" }],\n            \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }],\n            \"headline-lg\": [\"22px\", { \"lineHeight\": \"28px\", \"fontWeight\": \"700\" }],\n            \"label-md\": [\"11px\", { \"lineHeight\": \"14px\", \"fontWeight\": \"600\" }],\n            \"label-lg\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"700\" }],\n            \"headline-sm\": [\"16px\", { \"lineHeight\": \"22px\", \"fontWeight\": \"600\" }],\n            \"body-lg\": [\"15px\", { \"lineHeight\": \"22px\", \"fontWeight\": \"500\" }]\n          }\n        },\n      },\n    }\n  \u003c/script\u003e\n\u003cstyle\u003e\n    .no-scrollbar::-webkit-scrollbar { display: none; }\n    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n    .soft-card-shadow {\n      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04), 0 4px 14px rgba(15, 23, 42, 0.04);\n    }\n    .amber-glow {\n      box-shadow: 0 0 0 1px #ffb95f, 0 8px 24px -4px rgba(255, 185, 95, 0.35);\n    }\n    .material-symbols-outlined {\n      font-variation-settings: 'FILL' 0, 'wght' 500, 'GRAD' 0, 'opsz' 24;\n      line-height: 1;\n      display: inline-block;\n      vertical-align: middle;\n    }\n  \u003c/style\u003e\n\u003cstyle\u003e\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  \u003c/style\u003e\n  \u003c/head\u003e\n\u003cbody class=\"bg-background text-on-surface antialiased min-h-screen pb-28 selection:bg-primary selection:text-on-primary\"\u003e\n\u003c!-- TOP APP BAR (Shared Components JSON execution) --\u003e\n\u003cheader class=\"bg-surface-bright dark:bg-inverse-surface shadow-sm sticky top-0 z-40\"\u003e\n\u003cdiv class=\"flex justify-between items-center w-full px-margin py-space-sm\"\u003e\n\u003cdiv class=\"flex items-center space-x-2\"\u003e\n\u003cdiv class=\"w-8 h-8 rounded-xl bg-primary-fixed flex items-center justify-center text-primary\"\u003e\n\u003cspan class=\"material-symbols-outlined text-headline-sm\" data-icon=\"precision_manufacturing\"\u003eprecision_manufacturing\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cspan class=\"text-headline-md font-headline-md text-primary dark:text-inverse-primary tracking-tight\"\u003eTodd's Factory\u003c/span\u003e\n\u003cdiv class=\"flex items-center space-x-1.5 mt-0.5\"\u003e\n\u003cspan class=\"relative flex h-2 w-2\"\u003e\n\u003cspan class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75\"\u003e\u003c/span\u003e\n\u003cspan class=\"relative inline-flex rounded-full h-2 w-2 bg-secondary\"\u003e\u003c/span\u003e\n\u003c/span\u003e\n\u003cspan class=\"text-label-sm font-label-sm text-on-surface-variant\"\u003e3 active workflows • all systems nominal\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Trailing Action: Decision Support --\u003e\n\u003cbutton class=\"flex items-center space-x-1 bg-surface-container-lowest text-primary px-space-md py-space-xs rounded-full border border-outline-variant shadow-sm hover:bg-surface-container transition-colors scale-98 active:scale-95 duration-150 ease-out\"\u003e\n\u003cspan class=\"material-symbols-outlined text-body-md\" data-icon=\"smart_toy\"\u003esmart_toy\u003c/span\u003e\n\u003cspan class=\"text-label-lg font-label-lg\"\u003eDecision Support\u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003c/header\u003e\n\u003c!-- MAIN SCROLLABLE CONTENT CANVAS --\u003e\n\u003cmain class=\"px-margin pt-3 max-w-lg mx-auto flex flex-col space-y-4\"\u003e\n\u003c!-- TOP URGENT BANNER: \"Needs you (2)\" --\u003e\n\u003csection class=\"bg-tertiary-fixed text-on-tertiary-fixed rounded-2xl p-3.5 amber-glow transition-all\"\u003e\n\u003cdiv class=\"flex items-center justify-between mb-2\"\u003e\n\u003cdiv class=\"flex items-center space-x-2\"\u003e\n\u003cdiv class=\"flex items-center justify-center w-6 h-6 rounded-full bg-tertiary text-on-tertiary\"\u003e\n\u003cspan class=\"material-symbols-outlined text-label-lg\" data-icon=\"warning\"\u003ewarning\u003c/span\u003e\n\u003c/div\u003e\n\u003ch2 class=\"text-headline-sm font-headline-sm tracking-tight text-on-tertiary-fixed flex items-center gap-1.5\"\u003e\n            Needs you\n            \u003cspan class=\"bg-tertiary text-on-tertiary text-label-sm font-label-sm px-2 py-0.5 rounded-full\"\u003e2\u003c/span\u003e\n\u003c/h2\u003e\n\u003c/div\u003e\n\u003cspan class=\"text-label-sm font-label-sm text-on-tertiary-fixed-variant bg-surface-container-lowest/70 px-2 py-0.5 rounded-full\"\u003e2 blocking items\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"grid grid-cols-1 gap-2 pt-1\"\u003e\n\u003c!-- Item 1: UAT --\u003e\n\u003cdiv class=\"bg-surface-container-lowest/90 backdrop-blur-sm rounded-xl p-2.5 flex items-center justify-between border border-tertiary-fixed-dim\"\u003e\n\u003cdiv class=\"flex items-center space-x-2.5 min-w-0\"\u003e\n\u003cspan class=\"w-2.5 h-2.5 rounded-full bg-tertiary-container animate-pulse shrink-0\"\u003e\u003c/span\u003e\n\u003cdiv class=\"truncate\"\u003e\n\u003cp class=\"text-body-sm font-body-lg text-on-surface truncate\"\u003eTry the recipe screens (UAT)\u003c/p\u003e\n\u003cdiv class=\"flex items-center space-x-1.5 text-label-sm font-label-sm text-outline\"\u003e\n\u003cspan\u003eLIN-142\u003c/span\u003e\n\u003cspan\u003e•\u003c/span\u003e\n\u003cspan\u003eReady 14m\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cbutton class=\"shrink-0 ml-2 bg-primary text-on-primary text-label-sm font-label-lg px-2.5 py-1.5 rounded-lg active:scale-95 transition-transform flex items-center space-x-1\"\u003e\n\u003cspan\u003eReview Now\u003c/span\u003e\n\u003cspan class=\"material-symbols-outlined text-label-sm\" data-icon=\"arrow_forward\"\u003earrow_forward\u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003c!-- Item 2: Approval --\u003e\n\u003cdiv class=\"bg-surface-container-lowest/90 backdrop-blur-sm rounded-xl p-2.5 flex items-center justify-between border border-tertiary-fixed-dim\"\u003e\n\u003cdiv class=\"flex items-center space-x-2.5 min-w-0\"\u003e\n\u003cspan class=\"w-2.5 h-2.5 rounded-full bg-error shrink-0\"\u003e\u003c/span\u003e\n\u003cdiv class=\"truncate\"\u003e\n\u003cp class=\"text-body-sm font-body-lg text-on-surface truncate\"\u003eApprove 3 retro fixes\u003c/p\u003e\n\u003cdiv class=\"flex items-center space-x-1.5 text-label-sm font-label-sm text-outline\"\u003e\n\u003cspan\u003eValidation suite\u003c/span\u003e\n\u003cspan\u003e•\u003c/span\u003e\n\u003cspan\u003ePassed 98.4%\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cbutton class=\"shrink-0 ml-2 bg-secondary text-on-secondary text-label-sm font-label-lg px-3 py-1.5 rounded-lg active:scale-95 transition-transform\"\u003e\n            Approve (3)\n          \u003c/button\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/section\u003e\n\u003c!-- COLUMN PICKER (TABS) --\u003e\n\u003csection class=\"space-y-2\"\u003e\n\u003cdiv class=\"flex items-center justify-between\"\u003e\n\u003ch3 class=\"text-label-lg font-label-lg text-on-surface-variant flex items-center gap-1.5\"\u003e\n\u003cspan class=\"material-symbols-outlined text-body-md\" data-icon=\"view_kanban\"\u003eview_kanban\u003c/span\u003e\n          Pipeline Stages (8)\n        \u003c/h3\u003e\n\u003cspan class=\"text-label-sm font-label-sm text-primary font-bold\"\u003eShowing All Active\u003c/span\u003e\n\u003c/div\u003e\n\u003c!-- 8-Stage Horizontal Scrollable Track --\u003e\n\u003cdiv class=\"overflow-x-auto no-scrollbar -mx-margin px-margin flex space-x-2 py-1\"\u003e\n\u003c!-- 1. Backlog (1) --\u003e\n\u003cbutton class=\"shrink-0 bg-surface-container-low text-on-surface-variant border border-outline-variant/40 rounded-xl px-3 py-2 flex items-center space-x-1.5 hover:bg-surface-container transition-colors\"\u003e\n\u003cspan class=\"text-label-md font-label-md\"\u003eBacklog\u003c/span\u003e\n\u003cspan class=\"bg-surface-container-high text-on-surface-variant text-label-sm font-label-sm px-1.5 py-0.5 rounded-full\"\u003e1\u003c/span\u003e\n\u003c/button\u003e\n\u003c!-- 2. Ready (1) --\u003e\n\u003cbutton class=\"shrink-0 bg-surface-container-low text-on-surface-variant border border-outline-variant/40 rounded-xl px-3 py-2 flex items-center space-x-1.5 hover:bg-surface-container transition-colors\"\u003e\n\u003cspan class=\"text-label-md font-label-md\"\u003eReady\u003c/span\u003e\n\u003cspan class=\"bg-secondary-fixed text-on-secondary-fixed text-label-sm font-label-sm px-1.5 py-0.5 rounded-full\"\u003e1\u003c/span\u003e\n\u003c/button\u003e\n\u003c!-- 3. Implementation (1 live) [ACTIVE TAB] --\u003e\n\u003cbutton class=\"shrink-0 bg-primary-container text-on-primary rounded-xl px-3.5 py-2 flex items-center space-x-2 shadow-sm font-bold scale-100\"\u003e\n\u003cspan class=\"relative flex h-2 w-2\"\u003e\n\u003cspan class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary-container opacity-75\"\u003e\u003c/span\u003e\n\u003cspan class=\"relative inline-flex rounded-full h-2 w-2 bg-secondary-container\"\u003e\u003c/span\u003e\n\u003c/span\u003e\n\u003cspan class=\"text-label-md font-label-md\"\u003eImplementation\u003c/span\u003e\n\u003cspan class=\"bg-surface-container-lowest text-primary text-label-sm font-label-sm px-1.5 py-0.5 rounded-full\"\u003e1 live\u003c/span\u003e\n\u003c/button\u003e\n\u003c!-- 4. Evidence review (0) --\u003e\n\u003cbutton class=\"shrink-0 bg-surface-container-low text-outline border border-outline-variant/30 rounded-xl px-3 py-2 flex items-center space-x-1.5 opacity-70\"\u003e\n\u003cspan class=\"text-label-md font-label-md\"\u003eEvidence review\u003c/span\u003e\n\u003cspan class=\"text-label-sm font-label-sm\"\u003e0\u003c/span\u003e\n\u003c/button\u003e\n\u003c!-- 5. Remediation (1 stuck) [Alert dot] --\u003e\n\u003cbutton class=\"shrink-0 bg-error-container text-on-error-container rounded-xl px-3 py-2 flex items-center space-x-1.5\"\u003e\n\u003cspan class=\"w-2 h-2 rounded-full bg-error\"\u003e\u003c/span\u003e\n\u003cspan class=\"text-label-md font-label-md\"\u003eRemediation\u003c/span\u003e\n\u003cspan class=\"bg-error text-on-error text-label-sm font-label-sm px-1.5 py-0.5 rounded-full\"\u003e1 stuck\u003c/span\u003e\n\u003c/button\u003e\n\u003c!-- 6. Staging/smoke test (0) --\u003e\n\u003cbutton class=\"shrink-0 bg-surface-container-low text-outline border border-outline-variant/30 rounded-xl px-3 py-2 flex items-center space-x-1.5 opacity-70\"\u003e\n\u003cspan class=\"text-label-md font-label-md\"\u003eStaging/smoke\u003c/span\u003e\n\u003cspan class=\"text-label-sm font-label-sm\"\u003e0\u003c/span\u003e\n\u003c/button\u003e\n\u003c!-- 7. UAT (1 waiting) [Attention dot] --\u003e\n\u003cbutton class=\"shrink-0 bg-tertiary-fixed text-on-tertiary-fixed rounded-xl px-3 py-2 flex items-center space-x-1.5\"\u003e\n\u003cspan class=\"w-2 h-2 rounded-full bg-tertiary animate-pulse\"\u003e\u003c/span\u003e\n\u003cspan class=\"text-la