    "structuredContent": {
      "html": "<!DOCTYPE html>\n\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Mint &amp; Iris - Accordion - As loaded - Phone</title>\n<!-- Public Sans & JetBrains Mono fonts -->\n<link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&amp;family=Public+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<style>\n    body {\n      font-family: 'Public Sans', -apple-system, BlinkMacSystemFont, sans-serif;\n      background-color: #F3F6F8;\n      color: #1E293B;\n      margin: 0;\n      padding: 0;\n      -webkit-font-smoothing: antialiased;\n    }\n    .mono {\n      font-family: 'JetBrains Mono', monospace;\n    }\n    /* Smooth accordion transitions */\n    details summary::-webkit-details-marker {\n      display: none;\n    }\n    details summary {\n      list-style: none;\n    }\n    details[open] > summary .stage-chevron {\n      transform: rotate(180deg);\n    }\n    details.card-accordion[open] > summary .card-chevron {\n      transform: rotate(180deg);\n    }\n  </style>\n</head>\n<body class=\"min-h-screen bg-[#F3F6F8] text-slate-800 antialiased\">\n<!-- 390px mobile viewport container -->\n<main class=\"min-h-screen bg-[#F3F6F8] flex flex-col pb-8 border-slate-200/60 overflow-x-hidden w-full\">\n<!-- Top Brand & Header -->\n<header class=\"pt-4 px-4 pb-3 flex items-center justify-between border-b border-slate-200/80 bg-white/70 backdrop-blur-sm sticky top-0 z-30\">\n<div class=\"flex items-center gap-2\">\n<div class=\"w-8 h-8 rounded-lg bg-[#10B981] flex items-center justify-center text-white shadow-sm shadow-emerald-500/20\">\n<svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n<path d=\"M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n</svg>\n</div>\n<div>\n<h1 class=\"text-[17px] font-bold tracking-tight text-slate-900 leading-none\">Todd's Factory</h1>\n</div>\n</div>\n<a class=\"text-[13px] font-semibold text-[#059669] hover:text-emerald-700 bg-[#D1FAE5] px-2.5 py-1 rounded-full transition-colors flex items-center gap-1\" href=\"#decision-support\">\n<span>Decision support</span>\n<svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n<path d=\"M9 5l7 7-7 7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n</svg>\n</a>\n</header>\n<!-- Top strip: Needs you (2) -->\n<section class=\"p-3.5 mx-3 mt-3 bg-white rounded-[12px] border border-amber-200/90 shadow-sm\"><div class=\"flex items-center gap-1.5 pb-2 mb-2 border-b border-amber-100\"><span class=\"w-2 h-2 rounded-full bg-amber-500 animate-pulse\"></span><span class=\"text-[13px] font-bold text-slate-900 tracking-tight\">Needs you (2)</span></div><div class=\"space-y-1.5\"><a class=\"flex items-center justify-between p-2 rounded-lg bg-amber-50/70 border border-amber-200/60 hover:bg-amber-50 transition-colors\" href=\"#recipe-uat\"><span class=\"text-[13px] font-semibold text-slate-900 leading-snug\">Try the recipe screens (UAT)</span><svg class=\"w-4 h-4 text-amber-600 shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><path d=\"M9 5l7 7-7 7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></a><a class=\"flex items-center justify-between p-2 rounded-lg bg-emerald-50/70 border border-emerald-200/60 hover:bg-emerald-50 transition-colors\" href=\"#retro-fixes\"><span class=\"text