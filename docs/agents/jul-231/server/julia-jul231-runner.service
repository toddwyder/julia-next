[Unit]
Description=Julia JUL-231 build runner

[Service]
WorkingDirectory=/home/ubuntu/julia-jul-231-build
Environment=BUILD_RUNNER_JOBS_DIR=/home/ubuntu/.local/state/julia-jul231/jobs-attempt-2
Environment=BUILD_RUNNER_REPO=/home/ubuntu/julia-jul-231-build
Environment=BUILD_RUNNER_SETTINGS=/home/ubuntu/julia-jul-231-build/ops/build-runner/machine-settings.json
Environment=BUILD_RUNNER_PORT=43127
ExecStart=/usr/local/bin/node /home/ubuntu/julia-jul-231-build/scripts/julia-agents.mjs -- /usr/local/bin/node /home/ubuntu/julia-jul-231-build/ops/build-runner/jobs.mjs
Restart=on-failure

[Install]
WantedBy=default.target
