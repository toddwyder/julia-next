[Unit]
Description=Julia JUL-231 control page

[Service]
WorkingDirectory=/home/ubuntu/julia-jul-231-build
Environment=JULIA_CONTROL_PORT=43126
Environment=JULIA_INITIALIZATION_DB=/home/ubuntu/.local/state/julia-jul231/initialization.db
Environment=JULIA_CONTROL_OPEN_BROWSER=0
Environment=JULIA_BUILD_RUNNER_URL=http://127.0.0.1:43127
ExecStart=/usr/local/bin/node /home/ubuntu/julia-jul-231-build/scripts/julia-agents.mjs -- /usr/local/bin/node /home/ubuntu/julia-jul-231-build/ops/mastra-agents/reviewer/src/mastra/control-server.ts
Restart=on-failure

[Install]
WantedBy=default.target
