[Unit]
Description=Fire the JUL-73 quota-reset acceptance re-run once, 15 minutes after Codex's own usage cap resets

[Timer]
# A fixed, one-time absolute date -- never a recurring calendar expression
# (no "daily", "*:0/15", etc.) -- so this can only ever fire once: Codex's
# own quota-reset time (2026-09-19 19:28 UTC) plus 15 minutes' margin.
OnCalendar=2026-09-19 19:43:00 UTC
Persistent=false
Unit=jul73-quota-reset.service

[Install]
WantedBy=timers.target
