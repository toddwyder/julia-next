# Managed by bootstrap-runner.sh -- no secrets belong in this file.
# LIBGL_ALWAYS_SOFTWARE (JUL-98, 2026-09-22): the daemon runs headless under
# Xvfb with no real GPU/DRI device; Electron's GPU process intermittently
# fails to init hardware acceleration and crashes the whole process (SIGILL).
# The wrapper /usr/bin/orca-ide runs serve in Node-only mode and rejects any
# unknown CLI flag (so --disable-gpu cannot reach the inner Electron
# instance it spawns) -- this env var reaches it instead. See README.md.
LIBGL_ALWAYS_SOFTWARE=1
ORCA_SERVE_ARGS=serve --pairing-address 100.125.239.98 --port 6768
