# Managed by bootstrap-runner.sh -- no secrets belong in this file.
# --disable-gpu (JUL-98, 2026-09-22): both Orca daemons run inside Xvfb, a
# virtual X server with no real GPU/DRI device behind it. Electron's GPU
# process still tries to initialize hardware acceleration there, fails, and
# takes the whole process down with it. See ops/orca-daemons/README.md.
ORCA_SERVE_ARGS=serve --pairing-address 100.125.239.98 --port 6768 --disable-gpu
