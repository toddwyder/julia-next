# /etc/systemd/system/julia-ready-queue.timer -- JUL-79.
# Fires julia-ready-queue.service every 5 minutes. Installed but NOT enabled
# by the laptop session; JUL-79's run enables it as its final step
# (sudo -n systemctl enable --now julia-ready-queue.timer).
[Unit]
Description=Every 5 minutes, run one julia-next Ready-queue check

[Timer]
OnBootSec=1min
OnUnitActiveSec=5min
AccuracySec=30s
Unit=julia-ready-queue.service

[Install]
WantedBy=timers.target
