[Unit]
Description=JUL-43 journey-accounting Axiom relay (trusted boundary)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/orca-runner/journey-relay/relay.mjs
EnvironmentFile=/etc/orca-runner/journey-axiom.env
# Runs as the dedicated axiom-relay service account, not the 'runner'
# builder account: same-UID processes can read each other's environment via
# /proc/<pid>/environ on Linux, so the relay needs its own account to keep
# the Axiom token out of reach of builder worktrees.
User=axiom-relay
Group=axiom-relay
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/orca-runner/journey-relay
UMask=0077
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
