[Unit]
Description=Cap Mastra Code's trace store every night

[Timer]
Unit=julia-trace-store.service
# Persistent catches up a missed night, so a store that grew while the server was off
# still shrinks on the next boot.
OnCalendar=*-*-* 04:40:00
Persistent=true
AccuracySec=15min

[Install]
WantedBy=timers.target
