[Unit]
Description=Julia build runner from main

[Service]
WorkingDirectory=%h/julia-machine-main
Environment=BUILD_RUNNER_JOBS_DIR=%h/.local/state/julia-jul231/jobs-attempt-2
Environment=BUILD_RUNNER_REPO=%h/julia-machine-main
Environment=BUILD_RUNNER_SETTINGS=%h/julia-machine-main/ops/build-runner/machine-settings.json
Environment=BUILD_RUNNER_PORT=43127
ExecStart=/usr/local/bin/node %h/.local/lib/julia-machine/server-main.mjs run %h/.config/julia-machine/config.json runner
Restart=on-failure

[Install]
WantedBy=default.target
