[Unit]
Description=Julia control page from main

[Service]
WorkingDirectory=%h/julia-machine-main
Environment=JULIA_CONTROL_PORT=43126
Environment=JULIA_INITIALIZATION_DB=%h/.local/state/julia-jul231/initialization.db
Environment=JULIA_CONTROL_OPEN_BROWSER=0
Environment=JULIA_BUILD_RUNNER_URL=http://127.0.0.1:43127
ExecStart=/usr/local/bin/node %h/.local/lib/julia-machine/server-main.mjs run %h/.config/julia-machine/config.json control
Restart=on-failure

[Install]
WantedBy=default.target
