[Unit]
Description=Check the Factory observability trace store stays within its budget
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=julia-factory
Group=julia-factory
# The check only stats the DuckDB file and its WAL; it never writes or deletes.
# It exits non-zero when the store is over budget or when supported DuckDB
# retention is not configured, so the journal shows the failure. Retention is
# now wired in `app/src/mastra/observability-store.ts` (DuckDBStore with
# DEFAULT_RETENTION) and pruned on schedule by `observability-retention.ts`, so
# this flag tells the check the supported bound is in place; a deploy that has
# not shipped that code yet should set it back to 0.
Environment=MASTRACODE_DUCKDB_RETENTION=1
ExecStart=/usr/bin/node /var/lib/julia-factory/app/ops/factory/trace-retention.mjs
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/julia-factory/.local/share/mastracode
NoNewPrivileges=true
PrivateTmp=true
