[Unit]
Description=Run the Factory DuckDB observability retention prune
After=network-online.target julia-factory-trial.service
Wants=network-online.target
# The prune runs inside the running Factory process (DuckDB allows one writer),
# so the app must be up and the route secret must exist.
ConditionPathExists=/etc/julia-factory-retention/secret.env

[Service]
Type=oneshot
User=julia-factory
Group=julia-factory
# The route secret and the Factory URL come from the root-owned config, never
# argv. The program signs an empty body and POSTs to the app's
# /julia/run-retention route, which runs the supported Mastra `prune()` plus the
# documented DuckDB `CHECKPOINT`. It exits non-zero when the run fails, so a
# failed prune is red in the journal instead of a silent env flag.
EnvironmentFile=/etc/julia-factory-retention/secret.env
ExecStart=/usr/bin/node /var/lib/julia-factory/app/ops/factory/trace-prune-request.mjs
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
