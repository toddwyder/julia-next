[Unit]
Description=Post the Factory Monday note every Monday

[Timer]
# Monday 08:00 UTC, after the weekend. Persistent so a missed fire (server
# restart) still runs; previousWeekWindow makes the reported week the same all
# day, so a late fire cannot split a week.
OnCalendar=Mon *-*-* 08:00:00 UTC
Persistent=true
AccuracySec=5m
Unit=julia-factory-monday-note.service

[Install]
WantedBy=timers.target
