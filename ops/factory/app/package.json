{
  "name": "julia-factory-trial",
  "version": "0.1.0",
  "description": "Mastra Factory: an agent-powered software delivery environment. Intake GitHub/Linear issues, work them with coding agents, and ship pull requests — all from your own deployable web app.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "mastra factory dev --dir src/mastra",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "check": "tsc --noEmit",
    "build": "mastra build --dir src/mastra",
    "start": "varlock run -- mastra start",
    "deploy": "mastra deploy"
  },
  "dependencies": {
    "@mastra/auth-workos": "1.6.6",
    "@mastra/code-sdk": "1.10.1",
    "@mastra/core": "1.74.0",
    "@mastra/duckdb": "1.12.1",
    "@mastra/e2b": "0.12.1",
    "@mastra/factory": "0.19.1",
    "@mastra/libsql": "1.25.0",
    "@mastra/memory": "1.35.0",
    "@mastra/observability": "1.18.3",
    "@mastra/pg": "1.29.0",
    "@mastra/platform-workspace": "1.6.1",
    "@mastra/redis-streams": "0.5.1",
    "pg": "^8.23.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "mastra": "1.31.3",
    "typescript": "^5.9.2",
    "varlock": "^1.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
