[Unit]
Description=Post the weekly Factory cost note to GitHub issues
After=network-online.target postgresql.service julia-factory-trial.service
Wants=network-online.target
ConditionPathExists=/etc/julia-factory-monday-note/config.env

[Service]
Type=oneshot
User=orchestrator-svc
Group=orchestrator-svc
# The trace-reader token comes from root-owned config. The existing publisher
# helper mints a fresh GitHub App installation token in-process on each run.
EnvironmentFile=/etc/julia-factory-monday-note/config.env
ExecStart=/usr/bin/node /opt/julia-factory-monday-note/ops/factory/monday-note-run.mjs

ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
