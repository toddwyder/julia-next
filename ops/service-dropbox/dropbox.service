[Unit]
Description=JUL-72 one-time service sign-up code drop box
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/orca-runner/service-dropbox/dropbox.mjs
EnvironmentFile=/etc/orca-runner/dropbox.env
# Runs as the dedicated dropbox-svc account, not `runner` and not
# `orchestrator-svc` -- same-UID processes can read each other's environment
# via /proc/<pid>/environ, and
# this process briefly handles four raw bearer tokens in memory per
# request, so it must not share a UID with any builder worktree or the
# publisher.
User=dropbox-svc
Group=dropbox-svc
# NoNewPrivileges is deliberately NOT set here: this process's entire security
# model depends on being ABLE to escalate through its narrowly scoped sudo rule.
# It never has write access to the
# destination secret files itself, and reaches them only by invoking
# write-secret.sh (root:root 0700) through the narrowly scoped
# `dropbox-svc ALL=(root) NOPASSWD: /opt/.../write-secret.sh` sudoers rule
# (see README.md). NoNewPrivileges blocks sudo's own setuid escalation
# outright (confirmed live, JUL-72: "sudo: The 'no new privileges' flag is
# set, which prevents sudo from running as root" -- every save silently
# failed until this was removed). The privilege this process CAN gain is
# already the minimum useful one: exactly one fixed, reviewable script, no
# arguments beyond a closed set of four field names.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/orca-runner/service-dropbox
# ProtectSystem=strict makes /etc read-only for the WHOLE cgroup, including
# a child process sudo has escalated to root -- confirmed live, JUL-72:
# even with NoNewPrivileges gone and sudo genuinely reaching root
# (pam_unix session opened for user root), write-secret.sh's own mktemp
# still failed with "Read-only file system", because sudo changes UID, not
# the mount namespace systemd already set up for this unit. The secrets
# directory has to be named here explicitly, or root itself still can't
# write to it from inside this unit.
ReadWritePaths=/var/lib/dropbox-svc /etc/orca-runner/dropbox-secrets
UMask=0077
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
