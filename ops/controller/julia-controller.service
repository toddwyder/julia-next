# julia-controller.service -- JUL-98 step 4. The Julia controller, as a systemd
# USER unit of the orchestrator-svc account.
#
# NOT installed into /etc and never copied anywhere. It is linked from inside
# the read-only, root-owned checkout, with no sudo:
#
#   export XDG_RUNTIME_DIR=/run/user/$(id -u) DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus
#   systemctl --user link /srv/orchestrator-svc/julia-next/ops/controller/julia-controller.service
#   systemctl --user enable --now julia-controller.service
#
# Without those two exports every `systemctl --user` command fails SILENTLY --
# no output, exit 1 -- which reads exactly like success. See
# docs/agents/jul43-coordinator-runbook.md, "systemctl --user fails silently in
# an Orca terminal".
#
# There is no User= or Group= here on purpose: a user unit cannot set them, and
# the identity is the account whose manager runs it (orchestrator-svc, the one
# account that can read linear-app-id/linear-app-secret from the drop box).
#
# ops/controller/units.test.mjs pins every directive below, so a later edit
# cannot quietly drop one.
[Unit]
Description=Julia controller -- carries one Ready card across the board at a time
Documentation=file:///srv/orchestrator-svc/julia-next/docs/agents/jul43-coordinator-runbook.md
# systemd never gives up on this service. The cost is that a bad build restarts
# every 5 seconds for ever instead of stopping; graph/controller/crash-loop.mjs
# is what makes that visible (a journal line on every start, and one comment on
# the card it was carrying once the restarts pile up). Nothing here relies on
# systemd to stop anything.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/srv/orchestrator-svc/julia-next
SyslogIdentifier=julia-controller
Environment=ORCA_BIN=/opt/Orca/orca-ide
# Optional on purpose (the leading `-`). A REQUIRED EnvironmentFile that is
# missing makes systemd fail the start before node runs, so the crash-loop
# banner could never be printed -- the one case it exists for. The controller's
# own preflight refuses to publish without the key, from inside node, loudly.
EnvironmentFile=-/etc/orchestrator-svc/.env.publisher
ExecStart=/usr/bin/node /srv/orchestrator-svc/julia-next/graph/controller/main.mjs --loop
Restart=always
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
