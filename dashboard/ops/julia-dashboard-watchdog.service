[Unit]
Description=Watch the Julia dashboard health check and tell Todd when it is down
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/julia-dashboard
EnvironmentFile=/etc/julia-dashboard.env
Environment=HOME=/home/ubuntu
# The probe needs no wrapper; only a notice opens 1Password, in a child process. Allow that
# child time to answer without the timer's own run being cut short.
TimeoutStartSec=180
ExecStart=/usr/local/bin/node /home/ubuntu/julia-dashboard/dashboard/scripts/watchdog.mjs
