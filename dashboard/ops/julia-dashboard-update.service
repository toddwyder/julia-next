[Unit]
Description=Update the Julia dashboard from main
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/julia-dashboard
EnvironmentFile=/etc/julia-dashboard.env
Environment=NODE_ENV=production
Environment=HOME=/home/ubuntu
TimeoutStartSec=900
ExecStart=/usr/local/bin/node /home/ubuntu/julia-dashboard/dashboard/scripts/update.mjs
